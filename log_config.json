{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard_flat": {
            "format": "[%(levelname)s] %(asctime)s - %(name)s (line:%(lineno)d): %(message)s"
        },
        "raw_message": {
            "format": "%(message)s"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "standard_flat",
            "stream": "ext://sys.stdout"
        },
        "rotating_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "formatter": "standard_flat",
            "filename": "logs/assistant.log",
            "maxBytes": 10485760,
            "backupCount": 5,
            "encoding": "utf8",
            "delay": true
        },
        "rotating_error_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "formatter": "standard_flat",
            "filename": "logs/error.log",
            "maxBytes": 10485760,
            "backupCount": 5,
            "encoding": "utf8",
            "level": "ERROR",
            "delay": true
        },
        "event_monitor_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "formatter": "raw_message",
            "filename": "logs/events.jsonl",
            "maxBytes": 10485760,
            "backupCount": 5,
            "encoding": "utf8",
            "delay": true
        }
    },
    "loggers": {
        "": {
            "handlers": ["console", "rotating_file", "rotating_error_file"],
            "level": "INFO"
        },
        "uvicorn": {
            "level": "ERROR",
            "propagate": false,
            "handlers": ["console", "rotating_file", "rotating_error_file"]
        },
        "max_assistant": {
            "level": "INFO",
            "propagate": true
        },
        "max_assistant.tools":{
            "level": "INFO",
            "propagate": true
        },
        "max_assistant.event_monitor": {
            "level": "INFO",
            "propagate": false,
            "handlers": ["event_monitor_file"]
        }
    }
}